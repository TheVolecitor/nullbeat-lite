# NullBeat Lite — Environment Configuration Example

# API Server Port (default: 3000)
PORT=3000

# Control Plane / Admin Dashboard Port (default: 3001)
ADMIN_PORT=3001

# Admin Password (leave blank on initial startup to set via 1st-time setup screen)
ADMIN_SECRET=

# Head Server URL (handles all uncached tracks for webseeding & stream generation)
HEAD_SERVER_URL=https://nullbeat.thevolecitor.qzz.io

# Tidal Developer Credentials (free from https://developer.tidal.com/)
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# Search cache TTL in seconds (default: 3 days = 259200)
SEARCH_CACHE_TTL=259200

# --- Floodgate / User Management (Optional) ---
# Max registered users (0 = unlimited; all users are tracked in SQLite KV store)
MAX_USERS=0

# Max users who can register using an invite code
MAX_INVITE_POOL=50

# Secret used for HMAC signature on invite codes
INVITE_SECRET=

# Comma-separated API keys that bypass all registration checks (optional)
# ALLOWED_KEYS=
